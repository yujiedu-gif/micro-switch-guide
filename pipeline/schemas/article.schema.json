{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MicroSwitchGuide article",
  "type": "object",
  "required": ["primary_keyword", "secondary_keywords", "owned_question", "title", "h1", "description", "slug", "category", "tags", "body_markdown", "used_claim_ids", "internal_links", "source_manufacturer_names", "sources"],
  "properties": {
    "primary_keyword": {"type": "string", "minLength": 2},
    "secondary_keywords": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "owned_question": {"type": "string", "minLength": 5},
    "title": {"type": "string", "minLength": 5},
    "h1": {"type": "string", "minLength": 5},
    "description": {"type": "string", "minLength": 140, "maxLength": 160},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "category": {"enum": ["Basics", "Selection Guides", "Waterproof Switches", "Troubleshooting", "Applications"]},
    "tags": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "body_markdown": {"type": "string", "minLength": 500},
    "used_claim_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "internal_links": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["target_job_id", "relation", "anchor_text", "url"],
        "properties": {
          "target_job_id": {"type": "string", "minLength": 1},
          "relation": {"enum": ["pillar", "supporting", "related"]},
          "anchor_text": {"type": "string", "minLength": 2},
          "url": {"type": "string", "minLength": 2}
        },
        "additionalProperties": false
      }
    },
    "source_manufacturer_names": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "title", "publisher", "url"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "publisher": {"type": "string", "minLength": 1},
          "url": {"type": "string", "format": "uri"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
