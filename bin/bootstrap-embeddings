#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV="$PROJECT_DIR/work/embedding-venv"
export SENTENCE_TRANSFORMERS_HOME="$PROJECT_DIR/work/models"

if [[ -x "$VENV/bin/python" ]] && "$VENV/bin/python" -c 'import sentence_transformers' 2>/dev/null; then
  "$VENV/bin/python" -c 'import sentence_transformers; print("sentence-transformers", sentence_transformers.__version__)'
  exit 0
fi

mkdir -p "$PROJECT_DIR/work"
if command -v uv >/dev/null 2>&1; then
  uv venv --python 3.12 "$VENV"
  uv pip install --python "$VENV/bin/python" 'sentence-transformers>=3,<6'
else
  PYTHON_CANDIDATE=""
  for candidate in python3.13 python3.12 python3.11 python3.10; do
    if command -v "$candidate" >/dev/null 2>&1; then
      PYTHON_CANDIDATE="$candidate"
      break
    fi
  done
  if [[ -z "$PYTHON_CANDIDATE" ]]; then
    echo "Python 3.10-3.13 or uv is required for the local embedding environment." >&2
    exit 1
  fi
  "$PYTHON_CANDIDATE" -m venv "$VENV"
  "$VENV/bin/python" -m pip install --upgrade pip
  "$VENV/bin/python" -m pip install 'sentence-transformers>=3,<6'
fi

"$VENV/bin/python" -c 'from sentence_transformers import SentenceTransformer; model=SentenceTransformer("sentence-transformers/all-mpnet-base-v2"); print(len(model.encode(["micro switch"])[0]))'
