#!/usr/bin/env bash
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export SENTENCE_TRANSFORMERS_HOME="$PROJECT_DIR/work/models"
PYTHON_BIN="python3"
if [[ -x "$PROJECT_DIR/work/embedding-venv/bin/python" ]]; then
  PYTHON_BIN="$PROJECT_DIR/work/embedding-venv/bin/python"
fi
exec "$PYTHON_BIN" "$PROJECT_DIR/pipeline/supervisor.py" --project-root "$PROJECT_DIR" "$@"
