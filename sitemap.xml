---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign collections = site.collections | where_exp: 'collection', 'collection.output != false' %}
  {% for collection in collections %}
    {% assign docs = collection.docs | where_exp: 'doc', 'doc.sitemap != false' %}
    {% for doc in docs %}
      <url>
        <loc>{{ doc.url | replace: '/index.html', '/' | absolute_url | xml_escape }}</loc>
        {% unless doc.sitemap_omit_lastmod %}
          {% assign modified_date = doc.last_updated | default: doc.last_modified_at | default: doc.date %}
          {% if modified_date %}<lastmod>{{ modified_date | date_to_xmlschema }}</lastmod>{% endif %}
        {% endunless %}
      </url>
    {% endfor %}
  {% endfor %}
  {% assign pages = site.html_pages | where_exp: 'doc', 'doc.sitemap != false' | where_exp: 'doc', 'doc.url != "/404.html"' %}
  {% for page in pages %}
    <url>
      <loc>{{ page.url | replace: '/index.html', '/' | absolute_url | xml_escape }}</loc>
      {% assign modified_date = page.last_updated | default: page.last_modified_at %}
      {% if modified_date %}<lastmod>{{ modified_date | date_to_xmlschema }}</lastmod>{% endif %}
    </url>
  {% endfor %}
  {% for file in site.static_files %}
    {% assign extension = file.extname | downcase %}
    {% if file.sitemap != false %}
      {% if extension == '.html' or extension == '.htm' or extension == '.xhtml' or extension == '.pdf' %}
        <url>
          <loc>{{ file.path | replace: '/index.html', '/' | absolute_url | xml_escape }}</loc>
          <lastmod>{{ file.modified_time | date_to_xmlschema }}</lastmod>
        </url>
      {% endif %}
    {% endif %}
  {% endfor %}
</urlset>
